generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Team {
  id   Int    @id @default(autoincrement())
  name String @default("") @db.VarChar(255)
  slug String @unique @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships       Membership[]
  assetTags         AssetTag[]
  assetObjects      AssetObject[]
  assetLogoTypes    AssetLogoType[]
  assetLogos        AssetLogo[]
  assetIpTypes      AssetIpType[]
  assetIps          AssetIp[]
  assetProductTypes AssetProductType[]
  assetProducts     AssetProduct[]
  assetPersonTypes  AssetPersonType[]
  assetPersons      AssetPerson[]
  taggingQueueItems TaggingQueueItem[]
  taggingAuditItems TaggingAuditItem[]
  featureLlmCalls   FeatureLlmCall[]
  configs           TeamConfig[]
}

// One record per OCR/feature decision attempt. Missing prices/usage remain null,
// rather than being reported as zero-cost calls. Request JSON excludes credentials.
model FeatureLlmCall {
  id          String @id @default(uuid()) @db.Uuid
  teamId      Int
  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  queueItemId Int?
  assetObjectId Int?
  kind        String @db.VarChar(20)
  model       String @db.VarChar(255)
  status      String @db.VarChar(20)
  durationMs  Int
  request     Json
  response    String? @db.Text
  rawResponse Json?
  error       String? @db.Text

  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  cachedInputTokens Int?
  reasoningTokens   Int?
  imageTokens       Int?

  currency                   String @default("USD") @db.VarChar(3)
  inputCost                  Decimal? @db.Decimal(18, 9)
  outputCost                 Decimal? @db.Decimal(18, 9)
  totalCost                  Decimal? @db.Decimal(18, 9)
  inputPricePerMillion       Decimal? @db.Decimal(18, 9)
  cachedInputPricePerMillion Decimal? @db.Decimal(18, 9)
  outputPricePerMillion      Decimal? @db.Decimal(18, 9)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([teamId, createdAt])
  @@index([queueItemId])
  @@index([assetObjectId])
}

model User {
  id   Int    @id @default(autoincrement())
  name String @default("") @db.VarChar(255)
  slug String @unique @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships Membership[]
}

model Membership {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, teamId])
}

model TeamConfig {
  id     Int    @id @default(autoincrement())
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id])
  key    String @db.VarChar(255)
  value  Json   @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([teamId, key])
}

model AssetObject {
  id               Int    @id @default(autoincrement())
  teamId           Int
  team             Team   @relation(fields: [teamId], references: [id])
  slug             String @unique @db.VarChar(64)
  materializedPath String
  name             String
  description      String
  tags             Json   @default("[]") // string[]
  content          Json   @default("{}") // Record<string, string>
  extra            Json   @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  taggingQueueItems TaggingQueueItem[]
  taggingAuditItems TaggingAuditItem[]
}

model AssetTag {
  id     Int  @id @default(autoincrement())
  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

  name           String     @db.VarChar(100)
  slug           String?    @db.VarChar(64) // 新增以后还不存在 slug，和 musedam 同步以后会有
  level          Int        @default(1) // 层级: 1-4（最大层级见 src/lib/tagging/tag-level.ts MAX_TAG_LEVEL）
  parentId       Int?
  parent         AssetTag?  @relation("TagHierarchy", fields: [parentId], references: [id])
  children       AssetTag[] @relation("TagHierarchy")
  sort           Int        @default(0) // 排序字段，数值越小排序越靠前
  taggingEnabled Boolean    @default(true) // 是否允许打标，默认开启
  extra          Json       @default("{}")

  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  taggingAuditItems TaggingAuditItem[]
  assetLogoTags     AssetLogoTag[]
  assetIpTags       AssetIpTag[]
  assetProductTags  AssetProductTag[]
  assetPersonTags   AssetPersonTag[]

  deletedAt DateTime? @db.Timestamptz(6)

  // Active sibling/root uniqueness is maintained by partial indexes in the migration.
  // Tombstones retain their original name, slug, hierarchy and historical foreign keys.
  @@index([teamId, deletedAt, parentId])
  @@index([slug])

}

enum AssetLogoProcessStatus {
  pending
  processing
  completed
  failed
}

enum AssetLogoReferenceMatchStrategy {
  highest
  average
}

model AssetLogoType {
  id     String @id @default(uuid()) @db.Uuid
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)
  sort Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  logos AssetLogo[]
}

model AssetLogo {
  id     String @id @default(uuid()) @db.Uuid
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  slug            String                 @unique @default(cuid()) @db.VarChar(64)
  name            String                 @db.VarChar(255)
  logoTypeId      String?                @db.Uuid
  logoType        AssetLogoType?         @relation(fields: [logoTypeId], references: [id], onDelete: SetNull)
  logoTypeName    String                 @db.VarChar(100)
  status          AssetLogoProcessStatus @default(pending)
  processingError String?                @db.Text
  processedAt     DateTime?              @db.Timestamptz(6)
  enabled         Boolean                @default(true)
  notes           String                 @default("") @db.Text
  referenceMatchStrategy AssetLogoReferenceMatchStrategy @default(highest)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  images AssetLogoImage[]
  tags   AssetLogoTag[]

  @@index([teamId, createdAt])
  @@index([teamId, status])
}

model AssetLogoImage {
  id          String    @id @default(uuid()) @db.Uuid
  assetLogoId String    @db.Uuid
  assetLogo   AssetLogo @relation(fields: [assetLogoId], references: [id], onDelete: Cascade)

  objectKey      String    @db.Text
  source         String?   @default("s3") @db.VarChar(32)
  mimeType       String    @db.VarChar(255)
  size           Int
  sort           Int       @default(0)
  pgvectorPointId  String?   @unique @db.VarChar(64)
  embeddingModel String?   @db.VarChar(128)
  embeddedAt     DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([assetLogoId, sort])
}

model AssetLogoTag {
  id          String    @id @default(uuid()) @db.Uuid
  assetLogoId String    @db.Uuid
  assetLogo   AssetLogo @relation(fields: [assetLogoId], references: [id], onDelete: Cascade)
  assetTagId  Int?
  assetTag    AssetTag? @relation(fields: [assetTagId], references: [id], onDelete: SetNull)

  tagPath Json @default("[]")
  sort    Int  @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([assetLogoId, assetTagId])
  @@index([assetLogoId, sort])
}

enum AssetIpProcessStatus {
  pending
  processing
  completed
  failed
}

enum AssetIpMatchPattern {
  whole
  partial
}

model AssetIpType {
  id     String @id @default(uuid()) @db.Uuid
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)
  sort Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  ips AssetIp[]
}

model AssetIp {
  id     String @id @default(uuid()) @db.Uuid
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  slug            String               @unique @default(cuid()) @db.VarChar(64)
  name            String               @db.VarChar(255)
  ipTypeId        String?              @db.Uuid
  ipType          AssetIpType?         @relation(fields: [ipTypeId], references: [id], onDelete: SetNull)
  ipTypeName      String               @db.VarChar(100)
  description     String               @default("") @db.Text
  matchPattern    AssetIpMatchPattern  @default(whole)
  status          AssetIpProcessStatus @default(pending)
  processingError String?              @db.Text
  processedAt     DateTime?            @db.Timestamptz(6)
  enabled         Boolean              @default(true)
  notes           String               @default("") @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  images AssetIpImage[]
  tags   AssetIpTag[]

  @@index([teamId, createdAt])
  @@index([teamId, status])
  @@index([matchPattern])
}

model AssetIpImage {
  id        String  @id @default(uuid()) @db.Uuid
  assetIpId String  @db.Uuid
  assetIp   AssetIp @relation(fields: [assetIpId], references: [id], onDelete: Cascade)

  objectKey               String    @db.Text
  source                  String?   @default("s3") @db.VarChar(32)
  mimeType                String    @db.VarChar(255)
  size                    Int
  sort                    Int       @default(0)
  partialMatchPatternName String?   @db.VarChar(64)
  cropXMin                Float?
  cropYMin                Float?
  cropXMax                Float?
  cropYMax                Float?
  cropImageWidth          Float?
  cropImageHeight         Float?
  cropSource              String?   @db.VarChar(32)
  cropDetectionLabel      String?   @db.VarChar(100)
  cropDetectionScore      Float?
  pgvectorPointId         String?   @unique @db.VarChar(64)
  embeddingModel          String?   @db.VarChar(128)
  embeddedAt              DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([assetIpId, sort])
  @@index([partialMatchPatternName])
}

model AssetIpTag {
  id         String    @id @default(uuid()) @db.Uuid
  assetIpId  String    @db.Uuid
  assetIp    AssetIp   @relation(fields: [assetIpId], references: [id], onDelete: Cascade)
  assetTagId Int?
  assetTag   AssetTag? @relation(fields: [assetTagId], references: [id], onDelete: SetNull)

  tagPath Json @default("[]")
  sort    Int  @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([assetIpId, assetTagId])
  @@index([assetIpId, sort])
}

enum AssetProductProcessStatus {
  pending
  processing
  completed
  failed
}

model AssetProductType {
  id     String @id @default(uuid()) @db.Uuid
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)
  sort Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  products AssetProduct[]
}

model AssetProduct {
  id     String @id @default(uuid()) @db.Uuid
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  slug            String                    @unique @default(cuid()) @db.VarChar(64)
  name            String                    @db.VarChar(255)
  productTypeId   String?                   @db.Uuid
  productType     AssetProductType?         @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  productTypeName String                    @db.VarChar(100)
  description     String                    @default("") @db.Text
  generalCategory String                    @default("") @db.VarChar(100)
  status          AssetProductProcessStatus @default(pending)
  processingError String?                   @db.Text
  processedAt     DateTime?                 @db.Timestamptz(6)
  enabled         Boolean                   @default(true)
  notes           String                    @default("") @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  images AssetProductImage[]
  tags   AssetProductTag[]

  @@index([teamId, createdAt])
  @@index([teamId, status])
  @@index([teamId, generalCategory])
}

model AssetProductImage {
  id             String       @id @default(uuid()) @db.Uuid
  assetProductId String       @db.Uuid
  assetProduct   AssetProduct @relation(fields: [assetProductId], references: [id], onDelete: Cascade)

  objectKey        String    @db.Text
  source           String?   @default("s3") @db.VarChar(32)
  mimeType         String    @db.VarChar(255)
  size             Int
  sort             Int       @default(0)
  pgvectorPointId  String?   @unique @db.VarChar(64)
  embeddingModel   String?   @db.VarChar(128)
  embeddedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([assetProductId, sort])
}

model AssetProductTag {
  id             String       @id @default(uuid()) @db.Uuid
  assetProductId String       @db.Uuid
  assetProduct   AssetProduct @relation(fields: [assetProductId], references: [id], onDelete: Cascade)
  assetTagId     Int?
  assetTag       AssetTag?    @relation(fields: [assetTagId], references: [id], onDelete: SetNull)

  tagPath Json @default("[]")
  sort    Int  @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([assetProductId, assetTagId])
  @@index([assetProductId, sort])
}

enum AssetPersonProcessStatus {
  pending
  processing
  completed
  failed
}

model AssetPersonType {
  id     String @id @default(uuid()) @db.Uuid
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)
  sort Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  persons AssetPerson[]
}

model AssetPerson {
  id     String @id @default(uuid()) @db.Uuid
  teamId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  slug            String                   @unique @default(cuid()) @db.VarChar(64)
  name            String                   @db.VarChar(255)
  personTypeId    String?                  @db.Uuid
  personType      AssetPersonType?         @relation(fields: [personTypeId], references: [id], onDelete: SetNull)
  personTypeName  String                   @db.VarChar(100)
  status          AssetPersonProcessStatus @default(pending)
  processingError String?                  @db.Text
  processedAt     DateTime?                @db.Timestamptz(6)
  enabled         Boolean                  @default(true)
  notes           String                   @default("") @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  images AssetPersonImage[]
  tags   AssetPersonTag[]

  @@index([teamId, createdAt])
  @@index([teamId, status])
}

model AssetPersonImage {
  id            String      @id @default(uuid()) @db.Uuid
  assetPersonId String      @db.Uuid
  assetPerson   AssetPerson @relation(fields: [assetPersonId], references: [id], onDelete: Cascade)

  objectKey        String    @db.Text
  source           String?   @default("s3") @db.VarChar(32)
  mimeType         String    @db.VarChar(255)
  size             Int
  sort             Int       @default(0)
  pgvectorPointId  String?   @unique @db.VarChar(64)
  embeddingModel   String?   @db.VarChar(128)
  embeddedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([assetPersonId, sort])
}

model AssetPersonTag {
  id            String      @id @default(uuid()) @db.Uuid
  assetPersonId String      @db.Uuid
  assetPerson   AssetPerson @relation(fields: [assetPersonId], references: [id], onDelete: Cascade)
  assetTagId    Int?
  assetTag      AssetTag?   @relation(fields: [assetTagId], references: [id], onDelete: SetNull)

  tagPath Json @default("[]")
  sort    Int  @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([assetPersonId, assetTagId])
  @@index([assetPersonId, sort])
}

// Vector tables for pgvector embeddings
model LogoVector {
  id               String    @id @db.VarChar(64)
  teamId           Int
  assetLogoId      String    @db.Uuid
  assetLogoImageId String    @db.Uuid
  logoTypeId       String?   @db.Uuid
  enabled          Boolean   @default(true)
  status           String    @db.VarChar(20)
  embedding        Unsupported("vector(1024)")
  embeddingModel   String?   @db.VarChar(128)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  @@index([teamId, status, enabled])
  @@index([assetLogoId])
}

model IpVector {
  id                      String    @id @db.VarChar(64)
  teamId                  Int
  assetIpId               String    @db.Uuid
  assetIpImageId          String?   @db.Uuid
  ipTypeId                String?   @db.Uuid
  enabled                 Boolean   @default(true)
  matchPattern            String    @db.VarChar(20)
  partialMatchPatternName String?   @db.VarChar(64)
  status                  String    @db.VarChar(20)
  sourceType              String?   @db.VarChar(20)
  embedding               Unsupported("vector(768)")
  embeddingModel          String?   @db.VarChar(128)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)

  @@index([teamId, status, enabled])
  @@index([teamId, sourceType, status, enabled])
  @@index([assetIpId])
}

model ProductVector {
  id                 String    @id @db.VarChar(64)
  teamId             Int
  assetProductId     String    @db.Uuid
  assetProductImageId String?  @db.Uuid
  productTypeId      String?   @db.Uuid
  generalCategory    String    @db.VarChar(100)
  enabled            Boolean   @default(true)
  status             String    @db.VarChar(20)
  sourceType         String?   @db.VarChar(20)
  embedding          Unsupported("vector(768)")
  embeddingModel     String?   @db.VarChar(128)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  @@index([teamId, status, enabled])
  @@index([teamId, sourceType, status, enabled])
  @@index([assetProductId])
}

model PersonVector {
  id                 String    @id @db.VarChar(64)
  teamId             Int
  assetPersonId      String    @db.Uuid
  assetPersonImageId String    @db.Uuid
  personTypeId       String?   @db.Uuid
  enabled            Boolean   @default(true)
  status             String    @db.VarChar(20)
  embedding          Unsupported("vector(512)")
  embeddingModel     String?   @db.VarChar(128)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  @@index([teamId, status, enabled])
  @@index([assetPersonId])
}

enum TaggingQueueStatus {
  pending
  processing
  completed
  failed
}

enum TaggingTaskType {
  default
  test
  manual
  scheduled
}

model TaggingQueueItem {
  id            Int                @id @default(autoincrement())
  teamId        Int
  team          Team               @relation(fields: [teamId], references: [id])
  assetObjectId Int?
  assetObject   AssetObject?       @relation(fields: [assetObjectId], references: [id], onDelete: SetNull)
  status        TaggingQueueStatus
  taskType      TaggingTaskType    @default(default) // 任务类型：default=默认任务，test=测试任务
  startsAt      DateTime?          @db.Timestamptz(6)
  endsAt        DateTime?          @db.Timestamptz(6)
  result        Json               @default("{}")
  extra         Json               @default("{}")

  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  taggingAuditItems TaggingAuditItem[]

  @@index([teamId, status])
  @@index([status, createdAt])
  @@index([status, updatedAt])
}

enum TaggingAuditStatus {
  pending
  approved
  rejected
}

model TaggingAuditItem {
  id            Int                @id @default(autoincrement())
  teamId        Int
  team          Team               @relation(fields: [teamId], references: [id])
  assetObjectId Int?
  assetObject   AssetObject?       @relation(fields: [assetObjectId], references: [id], onDelete: SetNull)
  status        TaggingAuditStatus
  score         Int
  tagPath       Json               @default("[]")
  leafTagId     Int?
  leafTag       AssetTag?          @relation(fields: [leafTagId], references: [id], onDelete: SetNull)
  queueItemId   Int?
  queueItem     TaggingQueueItem?  @relation(fields: [queueItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([teamId, status])
}
