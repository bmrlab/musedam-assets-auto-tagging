# database
DATABASE_URL=
SHADOW_DATABASE_URL=

# pgvector (PostgreSQL extension for vector search)
# - Requires PostgreSQL 14+ with pgvector extension enabled
# - Uses the same DATABASE_URL as the main app

# auth
AUTH_SECRET= # Added by `npx auth secret`. Read more: https://cli.authjs.dev
AUTH_TRUST_HOST="true" # required in production

# Object storage (S3-compatible). STORAGE_PROVIDER is informational only — switching cloud
# providers for private deployments is done purely by changing the S3_*/AWS_* values below,
# no code change needed. Client implementation: src/lib/s3.ts (hand-rolled AWS SigV4 signer,
# works against any S3-compatible API).
STORAGE_PROVIDER=aws-s3 # aws-s3 | aliyun-oss | volcengine-tos (TOS is S3-compatible too, untested)
S3_REGION=
# Use nginx proxy (localhost:9002) for minIO local dev in case browser uploads get CORS; nginx forwards to MinIO :9000
S3_ENDPOINT_URL=http://localhost:9002
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Batch exports use stable, unsigned object URLs. Grant anonymous GetObject access only to this
# prefix (MinIO: `mc anonymous set download <alias>/<bucket>/<folder>`).
S3_FOLDER=feature-library
# Addressing style is provider-specific. Aliyun OSS's S3-compatible endpoint requires
# virtual-hosted-style, so its deployment must set this to false.
S3_FORCE_PATH_STYLE=true
# AWS S3 honors x-amz-acl on PUT for per-object ACLs. If a provider's S3-compatible layer
# rejects/ignores this header, set to false and grant anonymous read via a bucket policy instead.
S3_SEND_ACL_HEADER=true

# --- Aliyun OSS example (private deployment) ---
# STORAGE_PROVIDER=aliyun-oss
# S3_REGION=cn-hangzhou
# S3_ENDPOINT_URL=https://s3.oss-cn-hangzhou.aliyuncs.com
# AWS_ACCESS_KEY_ID=<Aliyun AccessKey ID>
# AWS_SECRET_ACCESS_KEY=<Aliyun AccessKey Secret>
# S3_BUCKET=<oss-bucket-name>
# S3_FORCE_PATH_STYLE=false
# S3_SEND_ACL_HEADER=true    # OSS's S3 compatibility API supports public-read. If customer
#                            # policy forbids object ACLs, set false and grant GetObject only
#                            # for S3_FOLDER through a bucket policy instead.

# litellm
# For private deployments: only OPENAI_BASE_URL + OPENAI_API_KEY need to be set, pointing at
# the hosted model gateway — do NOT configure AWS_BEDROCK_*/AZURE_EASTUS2_* there. See
# src/ai/provider.ts: llm() falls back to this gateway for every model when those
# provider-specific keys are absent.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# LLM_PROVIDER is optional — pins gateway/cloud instead of inferring from which keys are set.
# LLM_PROVIDER=gateway

# AWS_BEDROCK_REGION / AWS_BEDROCK_ACCESS_KEY_ID / AWS_BEDROCK_SECRET_ACCESS_KEY and
# AZURE_EASTUS2_RESOURCE_NAME / AZURE_EASTUS2_API_KEY are SaaS-only, optional. Leave unset for
# private deployments (see src/ai/provider.ts).

# TAGGING_PREDICT_MODEL/PRODUCT_CATEGORY_PREDICT_MODEL/TAG_TREE_GENERATE_MODEL take any gateway
# model id directly (e.g. a real CR alias) — sent through unmodified, see src/ai/provider.ts.
TAGGING_PREDICT_MODEL=gpt-5-mini

# MuseDAM
MUSEDAM_API_BASE_URL=
MUSEDAM_APP_API_KEY=
MUSEDAM_APP_SECRET=

# cipher, 使用 MuseDAM 的 app secret 相同的值
CIPHER_PASSWORD=

# iframe
IFRAME_ALLOWED_ORIGINS="'self' http://localhost:* https://localhost:* https://*.test.tezign.com"

# internal api
INTERNAL_API_KEY=
# Scheduler container only. The ACK manifest uses the cluster-local Web Service.
APP_INTERNAL_URL=http://musedam-auto-tagging-web:3000
QUEUE_POLL_INTERVAL_MS=30000
SCHEDULER_REQUEST_TIMEOUT_MS=900000

# Jina API. LLM_PROVIDER=gateway also routes embeddings through OPENAI_BASE_URL/OPENAI_API_KEY
# above (e.g. CR's /unified/v1/embeddings is Jina-request-compatible) — only JINA_EMBEDDING_MODEL
# (the gateway's own model id) is then read; its vectors won't match jina-clip-v2's, so switching
# needs reindexing existing embeddings. JINA_API_KEY below is only used otherwise.
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-clip-v2
JINA_EMBEDDINGS_URL=https://api.jina.ai/v1/embeddings
JINA_BATCH_SIZE=4
JINA_TIMEOUT_SECONDS=60
JINA_USE_PROXY=false
JINA_PROXY_URL=http://127.0.0.1:7890


# Logo detection service
LOGO_DETECTION_SERVER_URL=
LOGO_DETECTION_SERVER_TOKEN=
PRODUCT_CATEGORY_PREDICT_MODEL=gpt-5-mini

# translation service
TRANSLATION_SERVICE_URL=https://cloudnative.tezign.com/litellm/api/v1/chat/completions
TRANSLATION_SERVICE_API_KEY=
TRANSLATION_SERVICE_MODEL=qwen-mt-flash

# Debug pages
DEBUG_PAGE=false
LOCAL_DEV=false
