# database
DATABASE_URL=
SHADOW_DATABASE_URL=

# pgvector (PostgreSQL extension for vector search)
# - Requires PostgreSQL 14+ with pgvector extension enabled
# - Uses the same DATABASE_URL as the main app

# auth
AUTH_SECRET= # Added by `npx auth secret`. Read more: https://cli.authjs.dev
AUTH_TRUST_HOST="true" # required in production

# AWS S3 config
S3_REGION=
# Use nginx proxy (localhost:9002) for minIO local dev in case browser uploads get CORS; nginx forwards to MinIO :9000
S3_ENDPOINT_URL=http://localhost:9002
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Batch exports use stable, unsigned object URLs. Grant anonymous GetObject access only to this
# prefix (MinIO: `mc anonymous set download <alias>/<bucket>/<folder>`).
S3_FOLDER=feature-library

# litellm
OPENAI_BASE_URL=
OPENAI_API_KEY=

TAGGING_PREDICT_MODEL=qwen3-vl-flash

# MuseDAM
MUSEDAM_API_BASE_URL=
MUSEDAM_APP_API_KEY=
MUSEDAM_APP_SECRET=

# cipher, 使用 MuseDAM 的 app secret 相同的值
CIPHER_PASSWORD=

# iframe
IFRAME_ALLOWED_ORIGINS="'self' http://localhost:* https://localhost:* https://*.test.tezign.com"

# internal api
INTERNAL_API_KEY=

# Jina API
# true: public Jina API (international); false or unset: AWS SageMaker (mainland China)
IS_GLOBAL=true
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-clip-v2
JINA_EMBEDDINGS_URL=https://api.jina.ai/v1/embeddings
JINA_BATCH_SIZE=4
JINA_TIMEOUT_SECONDS=60
JINA_USE_PROXY=false
JINA_PROXY_URL=http://127.0.0.1:7890

# Required when IS_GLOBAL=false; these credentials are separate from the S3 credentials above
SAGEMAKER_AWS_REGION=ap-northeast-1
SAGEMAKER_AWS_ACCESS_KEY_ID=
SAGEMAKER_AWS_SECRET_ACCESS_KEY=
SAGEMAKER_ENDPOINT_NAME=Endpoint-Jina-CLIP-v2-1

# Logo detection service
LOGO_DETECTION_SERVER_URL=http://127.0.0.1:3002
LOGO_DETECTION_SERVER_TOKEN=test
PRODUCT_CATEGORY_PREDICT_MODEL=qwen3-vl-flash

# translation service
TRANSLATION_SERVICE_URL=https://cloudnative.tezign.com/litellm/api/v1/chat/completions
TRANSLATION_SERVICE_API_KEY=
TRANSLATION_SERVICE_MODEL=qwen-mt-flash

# Debug pages
DEBUG_PAGE=false
LOCAL_DEV=false
